PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=link_cloud

# Where downloaded files are stored (outside any web root)
STORAGE_DIR=./storage

# Auth (generate a long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me
# Registration is always open until the first user exists; set true to keep it open
ALLOW_REGISTRATION=false

# --- Phase 2 limits (all sizes in MB; 0 disables where noted) ---
MAX_FILE_MB=2048
# Total stored bytes allowed per user (0 = unlimited)
USER_QUOTA_MB=10240
# Refuse downloads that would take free disk below this
MIN_FREE_DISK_MB=1024
MAX_CONCURRENT_PER_USER=3

# Timeouts in milliseconds
CONNECT_TIMEOUT_MS=15000
IDLE_TIMEOUT_MS=60000
# Hard cap on a single download (0 = none); default 6 hours
TOTAL_TIMEOUT_MS=21600000
MAX_REDIRECTS=5

# DANGER: allows downloads from private/loopback addresses. Local testing only,
# never in production - it disables SSRF protection.
ALLOW_PRIVATE_TARGETS=false

# --- Phase 3: Redis + BullMQ ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Downloads running at once across ALL users, inside one worker process
MAX_CONCURRENT_GLOBAL=5
# Attempts per job (including the first) before it is permanently failed
RETRY_ATTEMPTS=3
# Base delay (ms) for exponential backoff between attempts
RETRY_BACKOFF_MS=10000
